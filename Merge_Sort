void merge_sort(std::vector<int>& array, int a, int b) {

    if (b - a <= 1) return;

    int diff = (b - a) / 2;

    int new_a = a + diff;

    int new_b = a + diff;

    merge_sort(array, a, new_b);

    merge_sort(array, new_a, b);

    int mid = a + (b - a) / 2;

    merge(array, a, mid, b);


}



