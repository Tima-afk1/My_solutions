void merge(std::vector<int>& array, int a, int mid, int b) {

    std::vector<int> memory;

    memory.reserve(b - a);

    int i = a;
    int j = mid;

    while (i < mid && j < b) {
        if (array[i] <= array[j]) {
            memory.push_back(array[i]);
            i++;
        }
        else {
            memory.push_back(array[j]);
            j++;
        }
    }
    while (i < mid) memory.push_back(array[i++]);
    while (j < b)   memory.push_back(array[j++]);



    i = a;
    while (i < b) {
        array[i] = memory[i - a];
        i++;
    }
}

