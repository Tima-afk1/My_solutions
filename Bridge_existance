int island_size_search(std::vector<std::vector<int>>& matrix, int x, int y, int n, int m, bool* bridge_existance) {

    int island_size = 0;

    split(matrix, x, y, &island_size, n, m, bridge_existance);

    return island_size;
}

void split(std::vector<std::vector<int>>& matrix, int x, int y, int* island_size, int n, int m, bool* bridge_existance) {

    *island_size += 1;

    matrix[x][y] = 0;

    if (x - 1 >= 0) {
        if (matrix[x - 1][y] == 1) {
            split(matrix, x - 1, y, island_size, n, m, bridge_existance);
        }
    }
    if (y + 2 < m) {
        if (matrix[x][y + 1] == 1) {
            split(matrix, x, y + 1, island_size, n, m, bridge_existance);
        }
    }
    if (y + 2 == m) {
        if (matrix[x][y + 1] == 1) {
            *bridge_existance = 1;
        }
    }
    if (x + 1 < n) {
        if (matrix[x + 1][y] == 1) {
            split(matrix, x + 1, y, island_size, n, m, bridge_existance);
        }
    }
    if (y - 1 >= 0) {
        if (matrix[x][y - 1] == 1) {
            split(matrix, x, y - 1, island_size, n, m, bridge_existance);
        }
    }
}




