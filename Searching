#include <iostream>
#include <vector>
#include <string>

int input(std::vector<int>& a);
void output(std::vector<int> a, int n);

int main()
{
    std::vector<int> array;

    int n = 0;

    n = input(array);

    int i = 0;
    int j = n - 1;

    int search_target = 0;
    std::cin >> search_target;

    int mid = i + (j - i) / 2;

    bool finded = 0;

    while (i != j) {
     
        if (array[mid] == search_target) {
            std::cout << (mid + 1);
            finded = true;
            break;
        }
        if (array[mid] > search_target) {
            j = mid;
            mid = i + (j - i) / 2;
        }
        else {
            i = mid;
            mid = i + (j - i) / 2;
        }
        if (i == mid) {
            break;
        }
    }
    if (finded == false) {
        std::cout << "unlucky";
    }
    if (finded == true) {
        //upserach
        int k = mid;
        while (array[k] == array[k + 1]) {
            std::cout << ' ' << (k + 2);
            k++;
            if (k == n - 1) {
                break;
            }
        }
        //downsearch
        k = mid;
        while (array[k] == array[k - 1] ) {
            std::cout << ' ' << k;
            k--;
            if (k == 0) {
                break;
            }
        }
    }
}


int input(std::vector<int>& a) {

    int n = 0;
    int wariable = 0;

    std::cin >> n;

    for (int i = 0; i < n; i++) {
        std::cin >> wariable;
        a.push_back(wariable);
    }
    return n;
}
