    int k = 0;

    for (int q = 0; q < b - a; q++) {

        if (i == j) {
            break;
        }
        if (j == b) {
            break;
        }


        if (array[i] <= array[j]) {
            i++;
        }
        else {
            shift(array, i, j, b);
            j++;

            i++;
        }
    }
}


void shift(std::vector<int>& array, int a, int mid, int b) {

    int reserve = array[mid];

    int reserve_for = 0;

    for (int i = mid; i > a; i--) {
        array[i] = array[i - 1];
    }
